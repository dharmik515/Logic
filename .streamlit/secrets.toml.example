# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
#
# NOTHING in this file belongs in the git repository. .gitignore already
# excludes .streamlit/secrets.toml - keep it that way.

# --- access -----------------------------------------------------------------
# CHANGE THIS. The built-in fallback is written in this app's public source,
# so until you set your own, anyone who finds the link can open the dashboard.
ADMIN_PIN = "choose-your-own"

# Starting PIN given to an agent who does not have one yet.
AGENT_PIN = "12345"

# --- your team --------------------------------------------------------------
# Seeds the roster on first run only; after that the admin panel owns it.
# Leave it out entirely and add everyone from the dashboard instead - which
# keeps your colleagues' names out of the repository altogether.
# AGENTS = "Asha, Ravi, Meera"

# Optional quick-pick labels on the differential rows (your regular clients).
# Leave unset to show just "+ Other".
# QUICK_REMARKS = "Client A, Client B"

# --- locale -----------------------------------------------------------------
APP_TIMEZONE = "Asia/Kolkata"

# --- storage ----------------------------------------------------------------
# REQUIRED for real use on Streamlit Community Cloud. Without these the app
# falls back to a local SQLite file, which the platform wipes whenever the app
# sleeps or redeploys. See README for the three-line table setup.
# SUPABASE_URL = "https://xxxxxxxx.supabase.co"
# SUPABASE_KEY = "your-service-role-key"
