# Copy to .streamlit/secrets.toml for local use, or paste the whole thing into
# Streamlit Community Cloud -> Manage app -> Settings -> Secrets.
#
# NOTHING here belongs in the git repository. .gitignore already excludes
# .streamlit/secrets.toml - keep it that way. Every PIN lives in this file and
# nowhere else, because the repository is public.

# ============================================================ 1. ACCESS ======
# REQUIRED. There is no admin PIN anywhere in the source code, so until you set
# this the dashboard cannot be opened by anyone - including you.
# Strongest: store a hash, so not even this file holds the password.
#   python tools/make_pin_hash.py
# ADMIN_PIN_HASH = "pbkdf2_sha256$120000$...."
#
# Or the plain PIN, which is fine too - secrets are never public.
ADMIN_PIN = "<choose-something-only-you-know>"

# Agent PINs, as "Name:PIN" pairs. Two ways to write them:
#
#   Simple  - the PIN itself. The app hashes it; delete this line afterwards
#             unless LOCK_PIN_CHANGES is on, which needs it to stay.
#   Safest  - an already-computed hash, from:  python tools/make_pin_hash.py --agents
#             Then the PIN is nowhere at all: not here, not in the database.
#
# Anyone left out keeps the random PIN the app generated for them.
AGENT_PINS = "Sultan:<pin>, Ifham:<pin>, Athar:<pin>, Neshar:<pin>, Aslam:<pin>, Ali:<pin>, Mirza:<pin>, Mudassir:<pin>, Abdulla:<pin>, Thalla:<pin>, Ibrahim:<pin>"

# Or one shared starting PIN for everybody, instead of the line above.
# AGENT_PIN = "<pin>"

# Lock the team down: with this on, nobody at the admin screen can add, remove
# or re-PIN anyone. AGENTS and AGENT_PINS above become the only way, re-applied
# on every start. Turn it on only once those two lines are filled in properly -
# an agent with no PIN listed would otherwise have no way to be given one.
# LOCK_PIN_CHANGES = true

# =========================================================== 2. STORAGE ======
# REQUIRED for real use. Without it the app writes to a local SQLite file, and
# Streamlit Community Cloud wipes that disk whenever the app sleeps or
# redeploys - you would lose the month's reports and every photo.
#
# Create a free Postgres (Neon is the quickest: neon.tech -> new project ->
# copy the connection string) and paste it here. The app creates its own
# tables on first connect, so there is no SQL to run.
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# Alternative, if direct Postgres connections are blocked on your network:
# SUPABASE_URL = "https://xxxxxxxx.supabase.co"
# SUPABASE_KEY = "your-service-role-key"

# ============================================================ 3. THE TEAM ====
# The roster and the quick-pick client names are already in lib/config.py.
# Override them here only if you want something different on this deployment.
# AGENTS = "Asha, Ravi, Meera"
# QUICK_REMARKS = "Samsung, Amazon"

# =============================================================== 4. LOCALE ===
APP_TIMEZONE = "Asia/Kolkata"
